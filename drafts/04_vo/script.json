 "lines": [
  {
   "id": "s1",
   "at": 0.3,
   "parts": [
    {
     "text": "You've got the perfect plan.",
     "speed": 0.93,
     "pause": 0.15
    },
    {
     "text": "Every detail mapped out.",
     "pause": 0.15
    },
    {
     "text": "You've read the books, made the lists\u2026",
     "pause": 0.2
    },
    {
     "text": "but you haven't taken a single step.",
     "speed": 0.9
    }
   ]
  },
  {
   "id": "s2",
   "at": 7.8,
   "parts": [
    {
     "text": "Weeks go by.",
     "speed": 0.92,
     "pause": 0.15
    },
    {
     "text": "You keep fixing the plan, waiting for the right moment\u2026",
     "pause": 0.15
    },
    {
     "text": "and nothing changes.",
     "speed": 0.9
    }
   ]
  },
  {
   "id": "s3",
   "at": 13.5,
   "parts": [
    {
     "text": "Brian Tracy puts it like this:",
     "pause": 0.2
    },
    {
     "text": "an average plan, vigorously executed,",
     "speed": 0.95,
     "pause": 0.1
    },
    {
     "text": "is far better than a brilliant plan on which nothing is done.",
     "speed": 0.95
    }
   ]
  },
  {
   "id": "s4",
   "at": 22.2,
   "parts": [
    {
     "text": "Execution is everything.",
     "speed": 0.92,
     "pause": 0.2
    },
    {
     "text": "So start here: pick the one task that moves you forward the most."
    }
   ]
  },
  {
   "id": "s5",
   "at": 28.0,
   "parts": [
    {
     "text": "Then do the first small step. Right now.",
     "pause": 0.15
    },
    {
     "text": "Make the call.",
     "pause": 0.1
    },
    {
     "text": "Write the first line.",
     "pause": 0.1
    },
    {
     "text": "Book the appointment."
    }
   ]
  },
  {
   "id": "s6",
   "at": 34.8,
   "parts": [
    {
     "text": "Every morning, start with that one task.",
     "speed": 1.0,
     "pause": 0.15
    },
    {
     "text": "Take action. Today.",
     "speed": 0.9
    }
   ]
  }
 ]
}
     "pause": 0.7
    },
    {
     "text": "It's the tiny decision you make every single morning.",
     "dir": "calm",
     "speed": 0.94,
     "pause": 0.7,
     "tag": "A2"
    },
    {
     "text": "Snooze... or stand up?",

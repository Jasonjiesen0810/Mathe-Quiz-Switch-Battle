 "lines": [
  {
   "id": "main",
   "at": 1.0,
   "parts": [
    {
     "text": "You are always busy,",
     "speed": 0.95,
     "pause": 0.05
    },
    {
     "text": "always moving,",
     "speed": 0.95,
     "pause": 0.05
    },
    {
     "text": "always climbing.",
     "speed": 0.93,
     "pause": 0.4
    },
    {
     "text": "But being busy is not the same as making progress.",
     "speed": 0.95,
     "pause": 0.55
    },
    {
     "text": "Stephen Covey said it well:",
     "speed": 0.97,
     "pause": 0.2
    },
    {
     "text": "if your ladder leans against the wrong wall,",
     "speed": 0.97,
     "pause": 0.05
    },
    {
     "text": "every step only takes you further to the wrong place.",
     "speed": 0.95,
     "pause": 0.6
    },
    {
     "text": "Brian Tracy puts it simply: clarity comes first.",
     "speed": 0.97,
     "pause": 0.55
    },
    {
     "text": "Remember this:",
     "speed": 0.95,
     "pause": 0.15
    },
    {
     "text": "never perfect a task that should not exist at all.",
     "speed": 0.93,
     "pause": 0.6
    },
    {
     "text": "Step one: be specific.",
     "speed": 0.95,
     "pause": 0.3
    },
    {
     "text": "Vague goals bring vague results.",
     "speed": 0.95,
     "pause": 0.3
    },
    {
     "text": "Not: get fit,",
     "speed": 0.95,
     "pause": 0.05
    },
    {
     "text": "but: run 5K by June.",
     "speed": 0.95,
     "pause": 0.55
    },
    {
     "text": "Step two: every morning, ask yourself:",
     "speed": 0.97,
     "pause": 0.15
    },
    {
     "text": "does this move me closer to my goal?",
     "speed": 0.95,
     "pause": 0.3
    },
    {
     "text": "If not, it can wait.",
     "speed": 0.93,
     "pause": 0.0
    }
   ]
  },
  {
   "id": "drop",
   "at": 38.85,
   "parts": [
    {
     "text": "Find the right wall.",
     "speed": 0.88,
     "pause": 0.35
    },
    {
     "text": "Then climb.",
     "speed": 0.82
    }
   ]
  }
 ]
}